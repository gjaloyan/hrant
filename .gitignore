# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- Build / dist ----------
build/
dist/
*.egg-info/
*.egg

# ---------- Node / Frontend ----------
frontend/node_modules/
frontend/dist/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Secrets & local config ----------
.env
.env.local
.env.*.local

# ---------- User data — NEVER committed to the engine repo ----------
# Engine ships only starter content in knowledge_templates/ and
# config.example.yaml. A fresh install creates ~/.hrant/data/ (or
# whatever HRANT_DATA_DIR points at) and copies templates over.
# In dev mode (single-tree), the repo root doubles as data_dir, so
# these directories exist locally but stay outside git.
knowledge/
workspace/
config.yaml

# Runtime overrides from the Engine + Voice + Autonomic settings tabs
# (live in data_dir; only visible at the repo root in dev mode).
runtime_overrides.json
autonomic_settings.json
update_history.json

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs & temp ----------
*.log
logs/
tmp/
temp/
text.txt

# ---------- Claude / plugin caches ----------
.claude/cache/
.claude/settings.local.json

# ---------- Dev mode captures ----------
# Per-request redacted LLM-call snapshots; user prunes manually.
dev/

# ---------- Local backups (Phase 8 migration) ----------
_backup_pre_*/

# Safety net: self_mods/ should ONLY live under data_dir
# (~/.hrant/data/self_mods/). If a test accidentally writes one
# at the repo root, we don't want it tracked.
self_mods/
