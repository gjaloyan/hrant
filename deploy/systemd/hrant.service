[Unit]
# Self-learning agent (Hrant) — systemd unit for user-mode operation.
# Install via `hrant gateway install` which renders this template into
# ~/.config/systemd/user/hrant.service with __PLACEHOLDERS__ filled in.
#
# Why user-mode (not system-mode):
#  - no sudo to manage
#  - reads $HOME for .env / config.yaml without needing extra mounts
#  - survives user logout when lingering is enabled
#    (loginctl enable-linger $USER)
#
# For system-wide service, copy this file to /etc/systemd/system/
# and remove the User= line.
Description=Hrant AI agent (FastAPI backend + Telegram bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=-__WORKDIR__/.env
# `hrant run` wraps uvicorn; --host/--port can be tweaked in this line
# without touching the rest of the unit.
ExecStart=__PYTHON_BIN__ -m backend.cli run --host __HOST__ --port __PORT__
# Restart on failure but not on clean shutdown (avoids the
# "constantly restarting on a misconfig" trap). Backoff 10s.
Restart=on-failure
RestartSec=10
# Stop the agent gracefully — uvicorn has its own SIGTERM handler.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
# Hardening: agent never needs root.
NoNewPrivileges=true
# PrivateTmp is OFF deliberately (2026-09-07). It gave the service a
# private /tmp, and it also made the service unable to create user
# namespaces: under it `unshare --user --fork --net` fails with EPERM,
# so `sandbox_exec` had no isolator at all and every call was refused.
# Measured per option — NoNewPrivileges is fine, PrivateTmp is what
# breaks it — and systemd 255 has no DelegateNamespaces to keep both.
#
# The trade: a private /tmp protects against other local users, of
# which this box has none, and the agent holds an unrestricted shell
# anyway. Real containment for untrusted input — an unknown archive, a
# freshly downloaded binary — is worth more than a separate /tmp.
# PrivateTmp=true
# Log to journal — `journalctl --user -u hrant -f` for live tail.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hrant

[Install]
WantedBy=default.target
